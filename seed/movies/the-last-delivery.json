  "episodes": [
    {
      "title": "The Call",
      "scenes": [
        {
          "speaker": "narrator",
          "text": "Rain had swallowed the streets by nightfall. Sam was preparing to finish his last delivery when his phone rang again.",
          "place": "street",
          "time": "night",
          "props": [
            "bike",
            "phone",
            "boxes"
          ],
          "characters": [
            "sam:140:think"
          ],
          "camera": "in",
          "fx": [
            "rain"
          ]
        },
        {
          "speaker": "mama",
          "text": "Sam, please. Daniel needs the medicine tonight. The clinic closes before morning.",
          "place": "apartment",
          "time": "night",
          "props": [
            "phone"
          ],
          "characters": [
            "mama:285",
            "daniel:150:crouch"
          ],
          "camera": "in"
        },
        {
          "speaker": "sam",
          "text": "I am coming. Keep him warm and stay by the phone.",
          "characters": [
            "sam:170"
          ]
        },
        {
          "speaker": "narrator",
          "text": "Sam grabbed the small medicine box from his delivery bag and stepped back into the rain.",
          "place": "street",
          "time": "night",
          "props": [
            "bike",
            "medbox"
          ],
          "characters": [
            "sam:130:walk"
          ],
          "camera": "in",
          "fx": [
            "rain"
          ]
        },
        {
          "speaker": "narrator",
          "text": "The main road was already underwater. A fallen sign blocked the bridge, and every route on Sam's phone ended in red lines.",
          "place": "floodedRoad",
          "time": "storm",
          "props": [
            "bridgeSign"
          ],
          "characters": [
            "sam:150:shock"
          ],
          "fx": [
            "rain"
          ],
          "camera": "in"
        },
        {
          "speaker": "sam",
          "text": "There has to be another way.",
          "characters": [
            "sam:160:think"
          ]
        }
      ]
    },
    {
      "title": "The Long Way",
      "scenes": [
        {
          "speaker": "narrator",
          "text": "Sam reached a tiny repair shop where one light was still burning. Inside, Emeka was closing for the night.",
          "place": "workshop",
          "time": "night",
          "props": [
            "table"
          ],
          "characters": [
            "emeka:290",
            "sam:105:walk"
          ],
          "fx": []
        },
        {
          "speaker": "sam",
          "text": "Uncle Emeka, do you know a road that is still open?",
          "characters": [
            "sam:145",
            "emeka:290"
          ]
        },
        {
          "speaker": "emeka",
          "text": "The road is gone. But the old service path behind the workshop still reaches the clinic.",
          "characters": [
            "emeka:285:point",
            "sam:145:think"
          ]
        },
        {
          "speaker": "narrator",
          "text": "Emeka pulled an old map from a drawer and pointed toward the hills. The path was longer, but it avoided the flooded bridge.",
          "place": "workshop",
          "time": "night",
          "props": [
            "map"
          ],
          "characters": [
            "emeka:280:point",
            "sam:140:think"
          ]
        },
        {
          "speaker": "sam",
          "text": "Thank you. I will make it before midnight.",
          "characters": [
            "sam:150:cheer",
            "emeka:290"
          ]
        },
        {
          "speaker": "narrator",
          "text": "The rain grew heavier as Sam followed the narrow road beyond the town. His phone battery dropped to its final bar.",
          "place": "servicePath",
          "time": "night",
          "props": [
            "bike",
            "phone",
            "medbox"
          ],
          "characters": [
            "sam:130>260:run"
          ],
          "camera": "in",
          "fx": [
            "rain"
          ]
        },
        {
          "speaker": "sam",
          "text": "Come on. Just a little farther.",
          "characters": [
            "sam:180:think"
          ]
        }
      ]
    },
    {
      "title": "Before Dawn",
      "scenes": [
        {
          "speaker": "narrator",
          "text": "At the end of the path, Sam found Daniel and Mama Ada waiting outside the clinic. The lights were still on.",
          "place": "clinic",
          "time": "dawn",
          "props": [
            "medbox"
          ],
          "characters": [
            "mama:280",
            "daniel:345:crouch",
            "sam:80>190:run"
          ],
          "camera": "in",
          "fx": []
        },
        {
          "speaker": "mama",
          "text": "You made it.",
          "characters": [
            "mama:280",
            "sam:190:cheer"
          ]
        },
        {
          "speaker": "narrator",
          "text": "Sam handed over the medicine. For the first time that night, Daniel smiled.",
          "place": "clinic",
          "time": "dawn",
          "props": [
            "medbox"
          ],
          "characters": [
            "sam:150:point",
            "mama:250",
            "daniel:340:cheer"
          ],
          "camera": "in"
        },
        {
          "speaker": "daniel",
          "text": "Thank you, Sam.",
          "characters": [
            "daniel:330"
          ]
        },
        {
          "speaker": "narrator",
          "text": "The storm finally began to weaken. Outside, the town was still dark, but a few windows started glowing one by one.",
          "place": "street",
          "time": "dawn",
          "characters": [
            "sam:130",
            "mama:240",
            "daniel:330"
          ],
          "camera": "out",
          "props": [
            "bike"
          ]
        },
        {
          "speaker": "narrator",
          "text": "Sam looked back at the flooded road and smiled. The longest delivery of his life had finally reached its destination.",
          "place": "street",
          "time": "dawn",
          "characters": [
            "sam:170:cheer"
          ],
          "camera": "in",
          "props": [
            "bike"
          ]
        }
      ]
    }
