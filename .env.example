# Copy to .env and edit. Every value is optional in development.

PORT=3000
NODE_ENV=development

# --- Database (MongoDB) ---------------------------------------------------
# Local:  docker compose up -d   (starts MongoDB on port 27017)
# Atlas:  mongodb+srv://user:password@cluster.xxxx.mongodb.net/cinebox
MONGODB_URI=mongodb://127.0.0.1:27017/cinebox

# --- Admin API ------------------------------------------------------------
# Protects /api/admin/*. If empty, the admin API is switched off.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=

# --- Demo movies ----------------------------------------------------------
# Import seed/movies/*.json when the database has no movies. Defaults to true in development, false in production.
# SEED_ON_BOOT=true
